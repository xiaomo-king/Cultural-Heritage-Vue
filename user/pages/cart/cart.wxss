.page {
  min-height: 100vh;
  background: #f5f0eb;
  padding-bottom: 120rpx;
}

/* 登录提示 */
.login-prompt {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0;
}
.login-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}
.login-text {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 30rpx;
}
.login-btn {
  padding: 20rpx 60rpx;
  background: #8B1A1A;
  color: #fff;
  border-radius: 40rpx;
  font-size: 28rpx;
}

/* 空 */
.empty-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0;
}
.empty-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}
.empty-text {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 8rpx;
}
.empty-desc {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 30rpx;
}
.shop-btn {
  padding: 20rpx 60rpx;
  background: #8B1A1A;
  color: #fff;
  border-radius: 40rpx;
  font-size: 28rpx;
}

/* 加载 */
.loading-wrap {
  display: flex;
  justify-content: center;
  padding: 60rpx 0;
}
.loading-spinner {
  width: 48rpx;
  height: 48rpx;
  border: 4rpx solid #e0e0e0;
  border-top-color: #8B1A1A;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}
@keyframes spin {
  to { transform: rotate(360deg); }
}

/* 购物车列表 */
.cart-list {
  padding: 20rpx 30rpx;
}
.cart-item {
  display: flex;
  align-items: center;
  background: #ffffff;
  border-radius: 16rpx;
  padding: 20rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
  position: relative;
}
.check-box {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  border: 2rpx solid #ddd;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 16rpx;
  flex-shrink: 0;
  font-size: 24rpx;
  color: #fff;
}
.check-box.checked {
  background: #8B1A1A;
  border-color: #8B1A1A;
}
.item-image {
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
  background: #f0f0f0;
  flex-shrink: 0;
}
.item-info {
  flex: 1;
  margin-left: 16rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  min-height: 160rpx;
}
.item-name {
  font-size: 26rpx;
  color: #2c1810;
  line-height: 1.3;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.item-spec {
  font-size: 22rpx;
  color: #999;
  margin-top: 4rpx;
}
.item-bottom {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.item-price {
  font-size: 30rpx;
  color: #C41E3A;
  font-weight: 600;
}
.quantity-control {
  display: flex;
  align-items: center;
  border: 2rpx solid #e0e0e0;
  border-radius: 8rpx;
}
.qty-btn {
  width: 52rpx;
  height: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: #666;
  background: #fafafa;
}
.qty-num {
  width: 60rpx;
  text-align: center;
  font-size: 26rpx;
  color: #2c1810;
}
.delete-btn {
  position: absolute;
  top: 8rpx;
  right: 12rpx;
  width: 40rpx;
  height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: #ccc;
}

/* 底部 */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  align-items: center;
  background: #ffffff;
  padding: 16rpx 30rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  border-top: 2rpx solid #f0f0f0;
  z-index: 100;
}
.check-all {
  display: flex;
  align-items: center;
}
.check-all .check-box {
  margin-right: 8rpx;
}
.check-all-text {
  font-size: 26rpx;
  color: #2c1810;
}
.total-section {
  flex: 1;
  text-align: right;
  margin-right: 20rpx;
}
.total-label {
  font-size: 24rpx;
  color: #666;
}
.total-price {
  font-size: 32rpx;
  color: #C41E3A;
  font-weight: 700;
}
.checkout-btn {
  padding: 20rpx 40rpx;
  background: linear-gradient(135deg, #8B1A1A, #C41E3A);
  color: #fff;
  border-radius: 40rpx;
  font-size: 28rpx;
  font-weight: 500;
}
.checkout-btn.disabled {
  background: #ccc;
}

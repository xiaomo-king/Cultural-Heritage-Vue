/* pages/checkin-detail/checkin-detail.wxss */
.page { background: #fff; min-height: 100vh; padding-bottom: 60rpx; }

.loading-box { display: flex; flex-direction: column; align-items: center; padding: 200rpx 0; color: #999; }
.loading-spinner { width: 60rpx; height: 60rpx; border: 4rpx solid #f0e8e0; border-top-color: #8B1A1A; border-radius: 50%; animation: spin 0.8s linear infinite; margin-bottom: 20rpx; }
@keyframes spin { to { transform: rotate(360deg); } }

.image-swiper { width: 100%; height: 750rpx; }
.swiper-img { width: 100%; height: 100%; background: #f0e8e0; }

.user-section {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx 30rpx;
  border-bottom: 2rpx solid #f5f5f5;
}
.user-left { display: flex; align-items: center; flex: 1; }
.user-avatar { width: 64rpx; height: 64rpx; border-radius: 50%; margin-right: 16rpx; background: #f0e8e0; flex-shrink: 0; }
.user-meta { display: flex; flex-direction: column; }
.user-name { font-size: 26rpx; font-weight: 600; color: #2c1810; }
.post-time { font-size: 22rpx; color: #999; margin-top: 4rpx; }
.follow-btn { padding: 10rpx 28rpx; border-radius: 30rpx; font-size: 24rpx; border: 2rpx solid #8B1A1A; color: #8B1A1A; font-weight: 500; }
.follow-btn.active { background: #f5f0eb; border-color: #ddd; color: #999; }

.title-section { padding: 24rpx 30rpx 0; }
.title-text { font-size: 34rpx; font-weight: 700; color: #1a1a1a; line-height: 1.4; }

.content-section { padding: 20rpx 30rpx; }
.content-text { font-size: 28rpx; line-height: 1.8; color: #444; white-space: pre-wrap; }

.meta-section { display: flex; align-items: center; gap: 24rpx; padding: 8rpx 30rpx 20rpx; }
.meta-time { font-size: 24rpx; color: #bbb; }
.meta-location { font-size: 24rpx; color: #8B1A1A; }

.heritage-link { display: flex; align-items: center; margin: 0 30rpx 20rpx; padding: 20rpx; background: #f8f6f4; border-radius: 16rpx; }
.heritage-icon { font-size: 28rpx; margin-right: 12rpx; }
.heritage-name { font-size: 26rpx; color: #2c1810; flex: 1; font-weight: 500; }
.heritage-arrow { font-size: 32rpx; color: #ccc; }

.actions-section { display: flex; align-items: center; gap: 12rpx; padding: 16rpx 30rpx; margin: 0 30rpx 20rpx; border-top: 2rpx solid #f0f0f0; border-bottom: 2rpx solid #f0f0f0; }
.action-btn { display: flex; align-items: center; gap: 6rpx; padding: 12rpx 28rpx; border-radius: 30rpx; background: #f5f5f5; }
.action-btn.liked { background: #fff0f0; }
.action-icon { font-size: 28rpx; }
.action-count { font-size: 24rpx; color: #666; font-weight: 500; }

.comment-section { padding: 0 30rpx 30rpx; }
.comment-header { font-size: 30rpx; font-weight: 600; color: #2c1810; margin-bottom: 20rpx; }
.comment-input-area { display: flex; align-items: center; gap: 16rpx; margin-bottom: 24rpx; }
.comment-input { flex: 1; height: 64rpx; background: #f5f5f5; border-radius: 32rpx; padding: 0 24rpx; font-size: 26rpx; }
.comment-submit { height: 64rpx; line-height: 64rpx; background: #8B1A1A; color: #fff; border-radius: 32rpx; padding: 0 32rpx; font-size: 26rpx; }

.comment-item { display: flex; gap: 16rpx; padding: 20rpx 0; border-bottom: 2rpx solid #f5f0eb; }
.comment-avatar { width: 56rpx; height: 56rpx; border-radius: 50%; flex-shrink: 0; background: #f0e8e0; }
.comment-body { flex: 1; }
.comment-top { display: flex; justify-content: space-between; align-items: center; margin-bottom: 6rpx; }
.comment-nick { font-size: 24rpx; font-weight: 500; color: #333; }
.comment-time { font-size: 20rpx; color: #ccc; }
.comment-text { font-size: 27rpx; color: #555; line-height: 1.5; }
.empty-comment { text-align: center; padding: 40rpx; color: #ccc; font-size: 26rpx; }

/* 加载更多评论 */
.load-more { text-align: center; padding: 30rpx 0; }
.load-more-text { font-size: 24rpx; color: #bbb; }
.no-more-text { font-size: 22rpx; color: #d0d0d0; }

<view class="page">
  <!-- 收货地址 -->
  <view class="section address-section" catchtap="goToAddress">
    <block wx:if="{{selectedAddress}}">
      <view class="address-header">
        <text class="consignee">{{selectedAddress.consignee}}</text>
        <text class="phone">{{selectedAddress.phone}}</text>
      </view>
      <text class="address-detail">{{selectedAddress.region}} {{selectedAddress.detail}}</text>
    </block>
    <view class="address-empty" wx:else>
      <text class="add-icon">+</text>
      <text class="add-text">添加收货地址</text>
    </view>
    <text class="arrow">›</text>
  </view>

  <!-- 商品列表 -->
  <view class="section">
    <view class="section-title">商品信息</view>
    <view class="order-item" wx:for="{{items}}" wx:key="productId">
      <image class="item-image" src="{{item.productImage || '/images/tab_shop.png'}}" mode="aspectFill" lazy-load="{{true}}" />
      <view class="item-info">
        <text class="item-name">{{item.productName}}</text>
        <text class="item-spec" wx:if="{{item.spec}}">{{item.spec}}</text>
        <view class="item-bottom">
          <text class="item-price">¥{{item.price}}</text>
          <text class="item-qty">×{{item.quantity}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 备注 -->
  <view class="section">
    <view class="section-title">备注</view>
    <input class="remark-input" placeholder="选填：给商家的备注" value="{{remark}}" bindinput="onRemarkInput" />
  </view>

  <!-- 底部 -->
  <view class="bottom-bar">
    <view class="total-section">
      <text class="total-label">合计：</text>
      <text class="total-price">¥{{totalAmount}}</text>
    </view>
    <view class="submit-btn" catchtap="submitOrder">提交订单</view>
  </view>

  <!-- 遮罩加载 -->
  <view class="mask" wx:if="{{submitting}}">
    <view class="mask-content">
      <view class="loading-spinner"></view>
      <text>提交中...</text>
    </view>
  </view>
</view>

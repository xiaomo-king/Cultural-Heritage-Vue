/* pages/edit-profile/edit-profile.wxss */
.page { padding-bottom: 60rpx; background: #f5f0eb; min-height: 100vh; }
.form { padding: 30rpx; }
.form-item {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
}
.form-label {
  font-size: 26rpx;
  color: #999;
  display: block;
  margin-bottom: 12rpx;
}
.form-input {
  width: 100%;
  height: 64rpx;
  font-size: 28rpx;
  color: #333;
}
.form-textarea {
  width: 100%;
  min-height: 120rpx;
  font-size: 28rpx;
  color: #333;
  line-height: 1.6;
}

/* 头像 */
.avatar-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
}
.form-avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: #f0e8e0;
}
.change-tip {
  font-size: 26rpx;
  color: #8B1A1A;
}

/* 性别选择 */
.radio-group {
  display: flex;
  gap: 16rpx;
}
.radio-item {
  padding: 10rpx 32rpx;
  border-radius: 24rpx;
  font-size: 26rpx;
  background: #f5f5f5;
  color: #666;
}
.radio-item.active {
  background: #f5f0eb;
  color: #8B1A1A;
  font-weight: 600;
}

/* 保存 */
.save-btn {
  width: 100%;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  background: linear-gradient(135deg, #8B1A1A, #C41E3A);
  color: #fff;
  border-radius: 40rpx;
  font-size: 30rpx;
  font-weight: 600;
  margin-top: 20rpx;
}

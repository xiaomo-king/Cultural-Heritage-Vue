.page {
  min-height: 100vh;
  background: #f5f0eb;
}
.tabs {
  display: flex;
  background: #ffffff;
  border-bottom: 2rpx solid #f0f0f0;
}
.tab {
  flex: 1;
  text-align: center;
  padding: 24rpx 0;
  font-size: 28rpx;
  color: #666;
  position: relative;
}
.tab.active {
  color: #8B1A1A;
  font-weight: 600;
}
.tab.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 30%;
  right: 30%;
  height: 4rpx;
  background: #8B1A1A;
  border-radius: 2rpx;
}
.loading-wrap {
  display: flex;
  justify-content: center;
  padding: 60rpx 0;
}
.loading-spinner {
  width: 48rpx; height: 48rpx;
  border: 4rpx solid #e0e0e0;
  border-top-color: #8B1A1A;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}
@keyframes spin { to { transform: rotate(360deg); } }
.empty-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0;
}
.empty-icon { font-size: 80rpx; margin-bottom: 20rpx; }
.empty-text { font-size: 28rpx; color: #666; }
.list { padding: 20rpx 30rpx; }
.card {
  display: flex;
  background: #fff;
  border-radius: 16rpx;
  padding: 20rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
  position: relative;
}
.card-image {
  width: 160rpx; height: 160rpx;
  border-radius: 12rpx;
  background: #f0f0f0;
  flex-shrink: 0;
}
.card-info {
  flex: 1;
  margin-left: 16rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}
.card-name {
  font-size: 28rpx; font-weight: 500; color: #2c1810;
}
.card-desc {
  font-size: 22rpx; color: #999; line-height: 1.4;
}
.card-price {
  font-size: 30rpx; color: #C41E3A; font-weight: 600;
}
.card-category {
  font-size: 22rpx; color: #8B1A1A; background: #fdf0f0;
  padding: 4rpx 16rpx; border-radius: 6rpx; align-self: flex-start;
}
.fav-btn {
  position: absolute; top: 16rpx; right: 16rpx;
  font-size: 36rpx;
}

/* 点赞打卡卡片 */
.post-list { padding: 20rpx 30rpx; }
.post-card {
  display: flex;
  background: #fff;
  border-radius: 16rpx;
  padding: 20rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}
.post-cover {
  width: 200rpx; height: 200rpx;
  border-radius: 12rpx;
  background: #f0f0f0;
  flex-shrink: 0;
  margin-right: 16rpx;
}
.post-body {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  min-height: 200rpx;
}
.post-title {
  font-size: 28rpx; font-weight: 600; color: #2c1810;
  display: -webkit-box;
  -webkit-line-clamp: 1;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.post-content {
  font-size: 24rpx; color: #666;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  line-height: 1.5;
  margin: 4rpx 0;
}
.post-meta {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.heritage-tag {
  font-size: 20rpx; color: #8B1A1A; background: #fdf0f0;
  padding: 2rpx 12rpx; border-radius: 6rpx;
}
.post-time {
  font-size: 20rpx; color: #bbb;
}
.post-stats {
  display: flex;
  gap: 20rpx;
  font-size: 22rpx; color: #999;
}

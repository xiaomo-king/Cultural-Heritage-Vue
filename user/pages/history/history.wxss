/* pages/history/history.wxss */
.page { padding-bottom: 40rpx; background: #f5f0eb; min-height: 100vh; }

.tab-bar {
  display: flex;
  background: #fff;
  padding: 16rpx 30rpx;
  gap: 20rpx;
  margin-bottom: 16rpx;
}
.tab-item {
  font-size: 28rpx;
  color: #999;
  padding: 8rpx 0;
  position: relative;
}
.tab-item.active {
  color: #8B1A1A;
  font-weight: 600;
}
.tab-item.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 4rpx;
  background: #8B1A1A;
  border-radius: 2rpx;
}

.list { padding: 0 30rpx; }
.list-item {
  display: flex;
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
}
.item-cover {
  width: 160rpx;
  height: 160rpx;
  flex-shrink: 0;
  background: #f0e8e0;
}
.item-info {
  flex: 1;
  padding: 24rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
}
.item-title {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.item-time {
  font-size: 22rpx;
  color: #ccc;
  margin-top: 8rpx;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 200rpx 0;
}
.empty-icon { font-size: 80rpx; margin-bottom: 16rpx; }
.empty-text { font-size: 28rpx; color: #999; }

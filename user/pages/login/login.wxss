/* pages/login/login.wxss */
.page {
  padding: 60rpx 50rpx;
  background: #f5f0eb;
  min-height: 100vh;
}

/* ===== Logo ===== */
.logo-area {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 50rpx;
}
.logo-icon {
  font-size: 80rpx;
  margin-bottom: 16rpx;
}
.logo-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #8B1A1A;
  margin-bottom: 10rpx;
}
.logo-desc {
  font-size: 24rpx;
  color: #999;
}

/* ===== Tab切换 ===== */
.tab-bar {
  display: flex;
  background: #fff;
  border-radius: 30rpx;
  padding: 6rpx;
  margin-bottom: 36rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}
.tab-item {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  font-size: 28rpx;
  color: #999;
  border-radius: 24rpx;
}
.tab-item.active {
  background: #8B1A1A;
  color: #fff;
  font-weight: 600;
}

/* ===== 输入 ===== */
.input-group {
  margin-bottom: 24rpx;
}
.input-label {
  font-size: 26rpx;
  color: #666;
  display: block;
  margin-bottom: 10rpx;
}
.input-field {
  width: 100%;
  height: 80rpx;
  background: #fff;
  border-radius: 16rpx;
  padding: 0 28rpx;
  font-size: 28rpx;
  color: #333;
  box-sizing: border-box;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}

/* ===== 按钮 ===== */
.submit-btn {
  width: 100%;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  background: linear-gradient(135deg, #8B1A1A, #C41E3A);
  color: #fff;
  border-radius: 40rpx;
  font-size: 30rpx;
  font-weight: 600;
  margin-top: 20rpx;
}
.submit-btn.disabled {
  opacity: 0.4;
}

/* ===== 错误 ===== */
.error-tip {
  text-align: center;
  margin-top: 20rpx;
  font-size: 26rpx;
  color: #C41E3A;
}
.field-error {
  font-size: 22rpx;
  color: #C41E3A;
  margin-top: 6rpx;
  display: block;
}

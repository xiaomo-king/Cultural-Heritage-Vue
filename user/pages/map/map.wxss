/* pages/map/map.wxss */
.page { min-height: 100vh; background: #f5f0eb; padding-bottom: 140rpx; }

/* ===== 通用状态 ===== */
.loading-wrap {
  display: flex; flex-direction: column; align-items: center; justify-content: center;
  padding: 200rpx 0;
}
.loading-spinner {
  width: 48rpx; height: 48rpx;
  border: 4rpx solid #e0e0e0; border-top-color: #8B1A1A;
  border-radius: 50%; animation: spin 0.8s linear infinite;
  margin-bottom: 16rpx;
}
@keyframes spin { to { transform: rotate(360deg); } }
.loading-text { font-size: 26rpx; color: #999; }
.error-wrap {
  display: flex; flex-direction: column; align-items: center; padding: 200rpx 0;
}
.error-icon { font-size: 64rpx; margin-bottom: 16rpx; }
.error-text { font-size: 28rpx; color: #666; margin-bottom: 24rpx; }
.retry-btn { padding: 16rpx 48rpx; background: #8B1A1A; color: #fff; border-radius: 36rpx; font-size: 26rpx; }

/* ===== 轮播 ===== */
.banner { height: 340rpx; margin: 0; }
.banner-item { position: relative; width: 100%; height: 100%; }
.banner-image { width: 100%; height: 100%; background: #f0e8e0; }
.banner-mask {
  position: absolute; bottom: 0; left: 0; right: 0;
  padding: 60rpx 30rpx 24rpx;
  background: linear-gradient(transparent, rgba(0,0,0,0.65));
}
.banner-name { font-size: 36rpx; font-weight: 700; color: #fff; display: block; }
.banner-category { font-size: 22rpx; color: rgba(255,255,255,0.8); margin-top: 4rpx; display: block; }

/* ===== 分类入口 ===== */
.category-grid {
  display: flex; flex-wrap: wrap;
  padding: 20rpx 24rpx 10rpx;
  background: #fff; margin: 16rpx 20rpx;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}
.category-item {
  display: flex; flex-direction: column; align-items: center;
  width: 20%; margin-bottom: 16rpx;
}
.category-icon {
  width: 72rpx; height: 72rpx; border-radius: 50%;
  background: #f5f0eb;
  display: flex; align-items: center; justify-content: center;
  font-size: 32rpx; margin-bottom: 6rpx;
}
.category-name { font-size: 20rpx; color: #2c1810; }

/* ===== 列表标题 ===== */
.section-title-row {
  display: flex; justify-content: space-between; align-items: center;
  margin: 0 30rpx 16rpx;
}
.section-title { font-size: 30rpx; font-weight: 600; color: #2c1810; }
.section-count { font-size: 24rpx; color: #999; }

/* ===== 非遗滚动区 ===== */
.heritage-scroll {
  height: calc(100vh - 580rpx);
  padding: 0 30rpx 30rpx;
}

/* ===== 城市分组 ===== */
.city-group { margin-bottom: 30rpx; }
.city-header { display: flex; align-items: center; margin-bottom: 16rpx; }
.city-icon { font-size: 28rpx; margin-right: 8rpx; }
.city-name { font-size: 30rpx; font-weight: 600; color: #2c1810; }
.city-count { font-size: 22rpx; color: #999; margin-left: 12rpx; }

/* ===== 非遗网格 ===== */
.heritage-grid { display: flex; flex-wrap: wrap; gap: 16rpx; }
.heritage-item {
  width: calc(50% - 8rpx); background: #fff; border-radius: 16rpx;
  overflow: hidden; box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
}
.item-cover { width: 100%; height: 200rpx; background: #f0e8e0; }
.item-info { padding: 16rpx; }
.item-name { font-size: 26rpx; color: #2c1810; font-weight: 500; display: block; line-height: 1.3; }
.item-category { font-size: 22rpx; color: #8B1A1A; display: block; }

/* ===== 空数据 ===== */
.empty-state { display: flex; flex-direction: column; align-items: center; padding: 120rpx 0; }
.empty-icon { font-size: 64rpx; margin-bottom: 16rpx; }
.empty-text { font-size: 28rpx; color: #999; }

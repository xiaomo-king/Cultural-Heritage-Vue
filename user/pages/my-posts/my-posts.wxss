/* pages/my-posts/my-posts.wxss */
.page { padding-bottom: 40rpx; background: #f5f0eb; min-height: 100vh; }

.loading-box { display: flex; justify-content: center; padding: 200rpx 0; }
.loading-spinner { width: 60rpx; height: 60rpx; border: 4rpx solid #f0e8e0; border-top-color: #8B1A1A; border-radius: 50%; animation: spin 0.8s linear infinite; }
@keyframes spin { to { transform: rotate(360deg); } }


/* ===== 草稿箱 ===== */
.draft-section { padding: 20rpx 30rpx 0; }
.section-title-row { margin-bottom: 16rpx; }
.section-title { font-size: 30rpx; font-weight: 600; color: #2c1810; }
.draft-card {
  display: flex;
  background: #fff;
  border-radius: 16rpx;
  padding: 16rpx;
  margin-bottom: 12rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
  position: relative;
  border-left: 6rpx solid #D4A853;
}
.draft-cover {
  width: 100rpx;
  height: 100rpx;
  border-radius: 12rpx;
  background: #f0e8e0;
  flex-shrink: 0;
}
.draft-cover.placeholder { opacity: 0.3; }
.draft-info {
  flex: 1;
  margin-left: 16rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
}
.draft-content {
  font-size: 26rpx;
  color: #2c1810;
  line-height: 1.3;
  display: -webkit-box;
  -webkit-line-clamp: 1;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.draft-time {
  font-size: 20rpx;
  color: #bbb;
  margin-top: 4rpx;
}
.draft-tag {
  position: absolute;
  top: 12rpx;
  right: 48rpx;
  font-size: 20rpx;
  color: #D4A853;
  background: #fff8e0;
  padding: 2rpx 12rpx;
  border-radius: 4rpx;
}
.draft-delete {
  position: absolute;
  top: 8rpx;
  right: 12rpx;
  font-size: 28rpx;
  color: #ccc;
  padding: 8rpx;
}

/* ===== 已发布 ===== */
.post-section { padding: 20rpx 30rpx 0; }
.post-list { padding: 20rpx 30rpx; }
.post-card {
  display: flex;
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
}
.post-cover {
  width: 200rpx;
  height: 200rpx;
  flex-shrink: 0;
  background: #f0e8e0;
}
.card-body {
  flex: 1;
  padding: 20rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}
.post-content {
  font-size: 26rpx;
  color: #555;
  line-height: 1.5;
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.post-meta {
  display: flex;
  gap: 8rpx;
  margin: 10rpx 0;
}
.heritage-tag {
  background: #f5f0eb;
  color: #8B1A1A;
  padding: 4rpx 14rpx;
  border-radius: 16rpx;
  font-size: 20rpx;
}
.visibility-tag {
  padding: 4rpx 14rpx;
  border-radius: 16rpx;
  font-size: 20rpx;
}
.visibility-tag.public { background: #e8f5e9; color: #2E7D32; }
.visibility-tag.private { background: #fff3e0; color: #E65100; }

.card-actions {
  display: flex;
  gap: 16rpx;
  justify-content: flex-end;
}
.action-btn {
  font-size: 24rpx;
  padding: 6rpx 20rpx;
  border-radius: 20rpx;
}
.action-btn.edit { background: #f5f0eb; color: #8B1A1A; }
.action-btn.delete { background: #fff0f0; color: #C41E3A; }

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 200rpx 0;
}
.empty-icon { font-size: 80rpx; margin-bottom: 16rpx; }
.empty-text { font-size: 30rpx; color: #999; margin-bottom: 8rpx; }
.empty-sub { font-size: 26rpx; color: #ccc; }

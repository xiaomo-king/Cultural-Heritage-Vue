<view class="page">
  <!-- 加载中 -->
  <view class="loading-wrap" wx:if="{{loading}}">
    <view class="loading-spinner"></view>
  </view>

  <block wx:else>
    <!-- 状态条 -->
    <view class="status-bar">
      <text class="status-icon">{{statusIcon}}</text>
      <view class="status-info">
        <text class="status-text">{{statusText}}</text>
        <text class="status-tip">{{statusTip}}</text>
      </view>
    </view>

    <!-- 收货信息 -->
    <view class="section" wx:if="{{order.consignee}}">
      <view class="section-header">
        <text class="section-icon">📍</text>
        <text>收货信息</text>
      </view>
      <view class="info-row">
        <text>{{order.consignee}}　{{order.phone}}</text>
      </view>
      <view class="info-row">
        <text class="info-detail">{{order.addressRegion}} {{order.addressDetail}}</text>
      </view>
    </view>

    <!-- 商品列表 -->
    <view class="section">
      <view class="section-header">
        <text class="section-icon">📦</text>
        <text>商品信息</text>
      </view>
      <view class="order-item" wx:for="{{items}}" wx:key="id">
        <image class="item-image" src="{{item.productImage || '/images/tab_shop.png'}}" mode="aspectFill" lazy-load="{{true}}" />
        <view class="item-info">
          <text class="item-name">{{item.productName}}</text>
          <text class="item-spec" wx:if="{{item.spec}}">{{item.spec}}</text>
          <view class="item-bottom">
            <text class="item-price">¥{{item.price}}</text>
            <text class="item-qty">×{{item.quantity}}</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 订单信息 -->
    <view class="section">
      <view class="section-header">
        <text class="section-icon">📄</text>
        <text>订单信息</text>
      </view>
      <view class="info-row">
        <text class="info-label">订单号</text>
        <text class="info-value">{{order.orderNo}}</text>
      </view>
      <view class="info-row">
        <text class="info-label">下单时间</text>
        <text class="info-value">{{order.createdAt}}</text>
      </view>
      <view class="info-row" wx:if="{{order.paidAt}}">
        <text class="info-label">付款时间</text>
        <text class="info-value">{{order.paidAt}}</text>
      </view>
      <view class="info-row" wx:if="{{order.shippedAt}}">
        <text class="info-label">发货时间</text>
        <text class="info-value">{{order.shippedAt}}</text>
      </view>
      <view class="info-row" wx:if="{{order.receivedAt}}">
        <text class="info-label">收货时间</text>
        <text class="info-value">{{order.receivedAt}}</text>
      </view>
      <view class="info-row" wx:if="{{order.remark}}">
        <text class="info-label">备注</text>
        <text class="info-value">{{order.remark}}</text>
      </view>
    </view>

    <!-- 底部操作 -->
    <view class="bottom-actions">
      <view class="action-btn" catchtap="goToOrderList">返回订单列表</view>
      <view class="action-btn primary" wx:if="{{order.status === 'pending'}}" catchtap="goToPay">去支付</view>
      <view class="action-btn primary" wx:elif="{{order.status === 'shipped'}}" catchtap="confirmReceive">确认收货</view>
      <view class="action-btn primary" wx:elif="{{order.status === 'received' && !order.evaluated}}" catchtap="goToEvaluation">去评价</view>
    </view>
  </block>
</view>

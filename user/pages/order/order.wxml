<view class="page">
  <!-- Tab 切换 -->
  <view class="tabs">
    <view class="tab {{currentTab === tab.key ? 'active' : ''}}" wx:for="{{tabs}}" wx:key="key" catchtap="switchTab" data-key="{{tab.key}}">
      <text>{{tab.label}}</text>
    </view>
  </view>

  <!-- 搜索栏 -->
  <view class="search-bar">
    <input class="search-input" placeholder="搜索订单中的商品名称..." value="{{searchKeyword}}" bindinput="onSearchInput" bindconfirm="doSearch" confirm-type="search" />
    <text class="search-clear" wx:if="{{searchKeyword}}" catchtap="clearSearch">✕</text>
  </view>

  <!-- 加载中 -->
  <view class="loading-wrap" wx:if="{{loading && orders.length === 0}}">
    <view class="loading-spinner"></view>
    <text class="loading-text">加载中...</text>
  </view>

  <!-- 空数据 -->
  <view class="empty-wrap" wx:elif="{{!loading && orders.length === 0}}">
    <text class="empty-icon">📋</text>
    <text class="empty-text">暂无订单</text>
    <view class="shop-btn" catchtap="goToShop">去逛逛</view>
  </view>

  <!-- 订单列表 -->
  <view class="order-list" wx:if="{{orders.length > 0}}">
    <view class="order-card" wx:for="{{orders}}" wx:key="id">
      <!-- 订单头部 -->
      <view class="order-header">
        <text class="order-no">订单号：{{item.orderNo}}</text>
        <text class="order-status">{{statusMap[item.status] || item.status}}</text>
      </view>

      <!-- 商品列表 -->
      <view class="order-items" wx:if="{{item.items}}">
        <view class="order-item" wx:for="{{item.items}}" wx:for-item="sub" wx:key="id" catchtap="goToDetail" data-id="{{item.id}}">
          <image class="item-image" src="{{sub.productImage || '/images/tab_shop.png'}}" mode="aspectFill" lazy-load="{{true}}" />
          <view class="item-info">
            <text class="item-name">{{sub.productName}}</text>
            <text class="item-spec" wx:if="{{sub.spec}}">{{sub.spec}}</text>
            <view class="item-bottom">
              <text class="item-price">¥{{sub.price}}</text>
              <text class="item-qty">×{{sub.quantity}}</text>
            </view>
          </view>
        </view>
      </view>
      <view class="order-items" wx:else>
        <view class="order-item" catchtap="goToDetail" data-id="{{item.id}}">
          <text class="no-items">暂无商品信息</text>
        </view>
      </view>

      <!-- 订单底部 -->
      <view class="order-footer">
        <text class="order-total">共 {{item.items ? item.items.length : 0}} 件商品 合计：</text>
        <text class="order-price">¥{{item.totalAmount}}</text>
      </view>

      <!-- 操作按钮 -->
      <view class="order-actions" wx:if="{{item.status === 'pending'}}">
        <text class="countdown-timer">⏱️ {{item.countdown || '等待支付'}}</text>
        <view class="action-btn primary" catchtap="goToPay" data-id="{{item.id}}" data-orderno="{{item.orderNo}}">去支付</view>
      </view>
      <view class="order-actions" wx:elif="{{item.status === 'paid'}}">
        <view class="action-btn outline" catchtap="updateStatus" data-id="{{item.id}}" data-status="shipped">提醒发货</view>
      </view>
      <view class="order-actions" wx:elif="{{item.status === 'shipped'}}">
        <view class="action-btn primary" catchtap="updateStatus" data-id="{{item.id}}" data-status="received">确认收货</view>
      </view>
      <view class="order-actions" wx:elif="{{item.status === 'received' && !item.evaluated}}">
        <view class="action-btn primary" catchtap="goToEvaluation" data-id="{{item.id}}">去评价</view>
      </view>
      <view class="order-actions" wx:elif="{{item.status === 'received' && item.evaluated}}">
        <text class="evaluated-tag">已评价</text>
      </view>
    </view>
  </view>

  <!-- 加载更多 -->
  <view class="load-more" wx:if="{{hasMore}}">
    <text class="load-more-text">上滑加载更多</text>
  </view>
</view>

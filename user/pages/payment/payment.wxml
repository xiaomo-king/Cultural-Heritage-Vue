<view class="page">
  <!-- 加载中 -->
  <view class="loading-wrap" wx:if="{{loading}}">
    <view class="loading-spinner"></view>
    <text class="loading-text">加载订单信息...</text>
  </view>

  <block wx:else>
    <!-- 订单信息 -->
    <view class="order-summary">
      <text class="pay-icon">{{paid ? '✅' : '⏳'}}</text>
      <text class="order-amount">¥{{totalAmount}}</text>
      <text class="order-no">订单号：{{orderNo}}</text>
    </view>

    <!-- 支付方式 -->
    <view class="pay-method">
      <view class="method-header">支付方式</view>
      <view class="method-item selected">
        <text class="method-icon">💰</text>
        <view class="method-info">
          <text class="method-name">余额支付</text>
          <text class="method-balance">可用余额：¥{{balance}}</text>
        </view>
        <text class="check-mark">✓</text>
      </view>
    </view>

    <!-- 操作按钮 -->
    <view class="action-area" wx:if="{{!paid}}">
      <view class="pay-btn {{balance < totalAmount ? 'disabled' : ''}}" catchtap="confirmPay">
        <text wx:if="{{balance >= totalAmount}}">确认支付 ¥{{totalAmount}}</text>
        <text wx:else>余额不足，请先充值</text>
      </view>
      <view class="recharge-link" catchtap="goToRecharge">去充值</view>
    </view>

    <!-- 支付成功 -->
    <view class="success-area" wx:if="{{paid}}">
      <view class="success-icon">🎉</view>
      <text class="success-text">支付成功！</text>
      <view class="order-info">
        <text>订单号：{{orderNo}}</text>
        <text>支付金额：¥{{totalAmount}}</text>
      </view>
      <view class="success-actions">
        <view class="action-btn primary" catchtap="goToOrderDetail">查看订单</view>
        <view class="action-btn" catchtap="goToHome">返回首页</view>
      </view>
    </view>
  </block>
</view>

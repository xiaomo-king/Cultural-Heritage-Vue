.page {
  min-height: 100vh;
  background: #f5f0eb;
}

/* 加载 */
.loading-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 200rpx 0;
}
.loading-spinner {
  width: 48rpx;
  height: 48rpx;
  border: 4rpx solid #e0e0e0;
  border-top-color: #8B1A1A;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
  margin-bottom: 16rpx;
}
@keyframes spin {
  to { transform: rotate(360deg); }
}
.loading-text {
  font-size: 26rpx;
  color: #999;
}

/* 订单摘要 */
.order-summary {
  background: linear-gradient(135deg, #8B1A1A, #C41E3A);
  padding: 60rpx 30rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  color: #fff;
}
.pay-icon {
  font-size: 48rpx;
  margin-bottom: 16rpx;
}
.order-amount {
  font-size: 56rpx;
  font-weight: 700;
  margin-bottom: 12rpx;
}
.order-no {
  font-size: 24rpx;
  opacity: 0.8;
}

/* 支付方式 */
.pay-method {
  margin: 20rpx 30rpx;
  background: #ffffff;
  border-radius: 16rpx;
  padding: 24rpx;
}
.method-header {
  font-size: 28rpx;
  font-weight: 500;
  color: #2c1810;
  margin-bottom: 16rpx;
}
.method-item {
  display: flex;
  align-items: center;
  padding: 20rpx;
  background: #fafafa;
  border-radius: 12rpx;
  border: 2rpx solid #8B1A1A;
}
.method-icon {
  font-size: 40rpx;
  margin-right: 16rpx;
}
.method-info {
  flex: 1;
}
.method-name {
  font-size: 28rpx;
  color: #2c1810;
  font-weight: 500;
}
.method-balance {
  font-size: 22rpx;
  color: #999;
  margin-top: 4rpx;
}
.check-mark {
  font-size: 28rpx;
  color: #8B1A1A;
}

/* 操作区 */
.action-area {
  margin: 40rpx 30rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.pay-btn {
  width: 100%;
  text-align: center;
  padding: 26rpx 0;
  background: linear-gradient(135deg, #8B1A1A, #C41E3A);
  color: #fff;
  border-radius: 40rpx;
  font-size: 32rpx;
  font-weight: 600;
}
.pay-btn.disabled {
  background: #ccc;
}
.recharge-link {
  margin-top: 20rpx;
  font-size: 26rpx;
  color: #8B1A1A;
  text-decoration: underline;
}

/* 成功 */
.success-area {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 30rpx;
}
.success-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}
.success-text {
  font-size: 36rpx;
  font-weight: 600;
  color: #2c1810;
  margin-bottom: 30rpx;
}
.order-info {
  display: flex;
  flex-direction: column;
  align-items: center;
  font-size: 24rpx;
  color: #666;
  margin-bottom: 40rpx;
  gap: 8rpx;
}
.success-actions {
  display: flex;
  gap: 24rpx;
}
.action-btn {
  padding: 20rpx 48rpx;
  border-radius: 40rpx;
  font-size: 28rpx;
  border: 2rpx solid #ddd;
  color: #666;
}
.action-btn.primary {
  background: #8B1A1A;
  color: #fff;
  border: none;
}

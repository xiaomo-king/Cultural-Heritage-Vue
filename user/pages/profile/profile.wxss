/* pages/profile/profile.wxss */
.page { padding-bottom: 140rpx; background: #f5f0eb; min-height: 100vh; }

/* ===== 用户区域 ===== */
.user-section {
  padding: 60rpx 30rpx 50rpx;
  background: linear-gradient(135deg, #8B1A1A, #C41E3A);
}
.login-area {
  display: flex;
  flex-direction: column;
  align-items: center;
}
.avatar-placeholder {
  width: 120rpx;
  height: 120rpx;
  border-radius: 60rpx;
  background: rgba(255,255,255,0.2);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 56rpx;
  margin-bottom: 16rpx;
}
.login-text {
  font-size: 32rpx;
  color: #fff;
  font-weight: 500;
}
.login-desc {
  font-size: 24rpx;
  color: rgba(255,255,255,0.7);
  margin-top: 8rpx;
}

/* ===== 已登录 ===== */
.user-header {
  display: flex;
  align-items: center;
  gap: 24rpx;
}
.user-avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 60rpx;
  border: 4rpx solid rgba(255,255,255,0.4);
  background: rgba(255,255,255,0.2);
  flex-shrink: 0;
}
.user-meta { flex: 1; }
.user-name {
  font-size: 36rpx;
  color: #fff;
  font-weight: 600;
  display: block;
  margin-bottom: 10rpx;
}
.balance-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.balance-label {
  font-size: 24rpx;
  color: rgba(255,255,255,0.7);
}
.balance-num {
  font-size: 28rpx;
  color: #FFD700;
  font-weight: 600;
}
.recharge-btn {
  font-size: 22rpx;
  color: #fff;
  background: rgba(255,255,255,0.2);
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
}
.meta-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.profile-btn {
  font-size: 24rpx;
  color: #fff;
  background: rgba(255,255,255,0.2);
  padding: 8rpx 20rpx;
  border-radius: 24rpx;
}

/* ===== 统计卡片 ===== */
.stats-card {
  display: flex;
  background: #fff;
  margin: -30rpx 30rpx 20rpx;
  border-radius: 16rpx;
  padding: 30rpx 0;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
  position: relative;
  z-index: 2;
}
.stat-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.stat-label {
  font-size: 28rpx;
  color: #2c1810;
  font-weight: 500;
}
.stat-divider {
  width: 1px;
  height: 60rpx;
  background: #eee;
  align-self: center;
}

/* ===== 功能菜单 ===== */
.menu-list {
  margin: 20rpx 30rpx;
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
}
.menu-item {
  display: flex;
  align-items: center;
  padding: 30rpx 30rpx;
  border-bottom: 1px solid #f5f0eb;
}
.menu-item:last-child { border-bottom: none; }
.menu-item:active { background: #f9f5f0; }
.menu-icon { font-size: 36rpx; margin-right: 24rpx; }
.menu-text { flex: 1; font-size: 30rpx; color: #2c1810; font-weight: 500; }
.menu-arrow { font-size: 36rpx; color: #bbb; }

.page {
  min-height: 100vh;
  background: #f5f0eb;
}
.loading-wrap { display: flex; justify-content: center; padding: 120rpx 0; }
.loading-spinner { width: 48rpx; height: 48rpx; border: 4rpx solid #e0e0e0; border-top-color: #8B1A1A; border-radius: 50%; animation: spin 0.8s linear infinite; }
@keyframes spin { to { transform: rotate(360deg); } }
.empty-wrap { display: flex; flex-direction: column; align-items: center; padding: 120rpx 0; }
.empty-icon { font-size: 80rpx; margin-bottom: 20rpx; }
.empty-text { font-size: 28rpx; color: #666; }

/* 路线列表 */
.route-list { padding: 20rpx 30rpx; }
.route-card {
  display: flex;
  background: #fff;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
}
.card-cover {
  width: 200rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.card-emoji { font-size: 56rpx; }
.card-info { flex: 1; padding: 20rpx; display: flex; flex-direction: column; justify-content: space-between; }
.card-title { font-size: 30rpx; font-weight: 600; color: #2c1810; }
.card-desc { font-size: 24rpx; color: #999; line-height: 1.4; margin-top: 8rpx; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
.card-tags { display: flex; gap: 12rpx; margin-top: 12rpx; }
.tag { font-size: 20rpx; padding: 4rpx 16rpx; border-radius: 6rpx; }
.tag-city { background: #fdf0f0; color: #8B1A1A; }
.tag-duration { background: #f0f7f0; color: #2E7D32; }

/* 详情 */
.detail-view { padding-bottom: 40rpx; }
.detail-header {
  background: linear-gradient(135deg, #8B1A1A, #C41E3A);
  padding: 30rpx;
  color: #fff;
}
.back-btn { font-size: 26rpx; opacity: 0.9; display: inline-block; margin-bottom: 16rpx; }
.detail-title { font-size: 36rpx; font-weight: 700; display: block; margin-bottom: 12rpx; }
.detail-meta { display: flex; gap: 24rpx; margin-bottom: 12rpx; }
.meta-item { font-size: 24rpx; opacity: 0.85; }
.detail-desc { font-size: 26rpx; line-height: 1.5; opacity: 0.9; }

/* 时间线 */
.timeline { padding: 30rpx; }
.timeline-item {
  display: flex;
  position: relative;
  padding-left: 40rpx;
  padding-bottom: 40rpx;
}
.timeline-item:last-child { padding-bottom: 0; }
.timeline-item::before {
  content: '';
  position: absolute;
  left: 14rpx;
  top: 24rpx;
  bottom: 0;
  width: 4rpx;
  background: #e0e0e0;
}
.timeline-item:last-child::before { display: none; }
.timeline-dot {
  position: absolute;
  left: 6rpx;
  top: 8rpx;
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  background: #8B1A1A;
  border: 4rpx solid #f5f0eb;
}
.timeline-content {
  background: #fff;
  border-radius: 16rpx;
  padding: 20rpx;
  flex: 1;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}
.point-header { display: flex; align-items: center; gap: 16rpx; margin-bottom: 8rpx; }
.point-order { font-size: 22rpx; color: #8B1A1A; font-weight: 500; background: #fdf0f0; padding: 2rpx 12rpx; border-radius: 4rpx; }
.point-stay { font-size: 20rpx; color: #999; }
.point-name { font-size: 30rpx; font-weight: 600; color: #2c1810; display: block; margin-bottom: 6rpx; }
.point-note { font-size: 24rpx; color: #666; line-height: 1.5; }

/* pages/search/search.wxss */
.page { padding-bottom: 40rpx; background: #f5f0eb; min-height: 100vh; }

/* ===== 搜索栏 ===== */
.search-bar {
  display: flex;
  align-items: center;
  padding: 20rpx 30rpx;
  background: #fff;
  position: sticky;
  top: 0;
  z-index: 10;
}
.search-input {
  flex: 1;
  height: 72rpx;
  background: #f5f5f5;
  border-radius: 36rpx;
  padding: 0 30rpx;
  font-size: 28rpx;
}
.search-cancel {
  font-size: 28rpx;
  color: #666;
  margin-left: 20rpx;
  flex-shrink: 0;
}

/* ===== 搜索Tab栏 ===== */
.search-tabs {
  display: flex;
  background: #fff;
  border-radius: 12rpx;
  margin-bottom: 20rpx;
  padding: 4rpx;
}
.search-tab {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  font-size: 26rpx;
  color: #666;
  border-radius: 10rpx;
}
.search-tab.active {
  background: #8B1A1A;
  color: #fff;
  font-weight: 500;
}

/* 商品结果卡片 */
.product-list { }
.product-card {
  display: flex;
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
}

/* 打卡结果 */
.post-list { }
.post-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
}
.post-content {
  font-size: 26rpx;
  color: #2c1810;
  line-height: 1.5;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.post-meta {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #999;
}
.post-tag {
  font-size: 22rpx;
  color: #8B1A1A;
  background: #fdf0f0;
  padding: 4rpx 16rpx;
  border-radius: 6rpx;
}

/* ===== 热门搜索 ===== */
.suggest-section { padding: 30rpx; }
.suggest-title { font-size: 30rpx; font-weight: 600; color: #2c1810; margin-bottom: 20rpx; }
.suggest-tags { display: flex; flex-wrap: wrap; gap: 16rpx; }
.suggest-tag {
  background: #fff;
  padding: 12rpx 28rpx;
  border-radius: 30rpx;
  font-size: 26rpx;
  color: #8B1A1A;
  border: 1rpx solid #e8ddd0;
}

/* ===== 结果 ===== */
.result-section { padding: 0 30rpx; }
.result-header { padding: 20rpx 0; }
.result-count { font-size: 24rpx; color: #999; }

/* ===== 分组标题 ===== */
.result-group { margin-bottom: 20rpx; }
.group-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #2c1810;
  padding: 16rpx 0 12rpx;
  border-bottom: 1px solid #f0e8e0;
}

/* ===== 用户结果 ===== */
.user-list { }
.user-card {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 12rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
}
.user-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  margin-right: 20rpx;
  background: #f0e8e0;
  flex-shrink: 0;
}
.user-info { flex: 1; min-width: 0; }
.user-name { font-size: 28rpx; font-weight: 600; color: #2c1810; display: block; }
.user-meta { font-size: 22rpx; color: #999; margin-top: 4rpx; display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.user-arrow { font-size: 36rpx; color: #ccc; }

.heritage-list { }
.heritage-card {
  display: flex;
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
}
.card-cover {
  width: 180rpx; height: 180rpx;
  flex-shrink: 0;
  background: #f0e8e0;
}
.card-info { flex: 1; padding: 20rpx; display: flex; flex-direction: column; justify-content: center; }
.card-name { font-size: 28rpx; font-weight: 600; color: #2c1810; display: block; }
.card-category { font-size: 22rpx; color: #8B1A1A; margin: 6rpx 0; display: block; }
.card-summary { font-size: 24rpx; color: #888; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }

/* ===== 空状态 ===== */
.empty-state { display: flex; flex-direction: column; align-items: center; padding: 120rpx 0; }
.empty-icon { font-size: 80rpx; margin-bottom: 16rpx; }
.empty-text { font-size: 30rpx; color: #999; margin-bottom: 8rpx; }
.empty-sub { font-size: 26rpx; color: #ccc; }

/* ===== 加载 ===== */
.loading-box { display: flex; justify-content: center; padding: 100rpx; }
.loading-spinner { width: 50rpx; height: 50rpx; border: 4rpx solid #f0e8e0; border-top-color: #8B1A1A; border-radius: 50%; animation: spin 0.8s linear infinite; }
@keyframes spin { to { transform: rotate(360deg); } }

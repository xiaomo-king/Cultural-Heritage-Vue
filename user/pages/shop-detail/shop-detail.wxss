.page {
  min-height: 100vh;
  background: #f5f0eb;
  padding-bottom: 120rpx;
}

/* 加载 */
.loading-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 200rpx 0;
}
.loading-spinner {
  width: 48rpx;
  height: 48rpx;
  border: 4rpx solid #e0e0e0;
  border-top-color: #8B1A1A;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}
@keyframes spin {
  to { transform: rotate(360deg); }
}
.loading-text {
  font-size: 26rpx;
  color: #999;
  margin-top: 16rpx;
}

/* 图片轮播 */
.image-swiper {
  width: 100%;
  height: 750rpx;
  background: #f0f0f0;
}
.swiper-image {
  width: 100%;
  height: 100%;
}

/* 价格区 */
.price-section {
  background: #ffffff;
  padding: 30rpx;
  margin-bottom: 2rpx;
}
.price-row {
  display: flex;
  align-items: baseline;
}
.price-symbol {
  font-size: 24rpx;
  color: #C41E3A;
  font-weight: 600;
}
.price-num {
  font-size: 44rpx;
  color: #C41E3A;
  font-weight: 700;
}
.original-price {
  font-size: 24rpx;
  color: #bbb;
  text-decoration: line-through;
  margin-left: 12rpx;
}
.sales-tag {
  font-size: 22rpx;
  color: #999;
  margin-left: 20rpx;
}
.rating-row {
  display: flex;
  align-items: center;
  margin-top: 8rpx;
}
.rating-stars {
  font-size: 24rpx;
  color: #D4A853;
  letter-spacing: 2rpx;
}
.rating-num {
  font-size: 22rpx;
  color: #999;
  margin-left: 8rpx;
}

/* 商品信息 */
.info-section {
  background: #ffffff;
  padding: 30rpx;
  margin-bottom: 2rpx;
}
.product-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #2c1810;
  line-height: 1.4;
}
.product-desc {
  font-size: 26rpx;
  color: #666;
  line-height: 1.6;
  margin-top: 12rpx;
}

/* 规格 */
.spec-section {
  background: #ffffff;
  padding: 30rpx;
  margin-bottom: 2rpx;
}
.spec-label {
  font-size: 28rpx;
  font-weight: 500;
  color: #2c1810;
  margin-bottom: 16rpx;
  display: block;
}
.spec-options {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}
.spec-item {
  padding: 12rpx 28rpx;
  border: 2rpx solid #e0e0e0;
  border-radius: 8rpx;
  font-size: 26rpx;
  color: #2c1810;
  background: #fafafa;
}
.spec-item.active {
  border-color: #8B1A1A;
  color: #8B1A1A;
  background: #fdf0f0;
}

/* 数量选择 */
.qty-section {
  background: #ffffff;
  padding: 30rpx;
  margin-bottom: 2rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.qty-label {
  font-size: 28rpx;
  font-weight: 500;
  color: #2c1810;
}
.qty-control {
  display: flex;
  align-items: center;
  border: 2rpx solid #e0e0e0;
  border-radius: 8rpx;
}
.qty-btn {
  width: 60rpx;
  height: 52rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  color: #666;
  background: #fafafa;
}
.qty-input {
  width: 70rpx;
  height: 52rpx;
  text-align: center;
  font-size: 28rpx;
  color: #2c1810;
  border-left: 2rpx solid #e0e0e0;
  border-right: 2rpx solid #e0e0e0;
}

/* 非遗关联 */
.heritage-link {
  background: #ffffff;
  padding: 30rpx;
  margin-bottom: 2rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.link-label {
  font-size: 28rpx;
  color: #2c1810;
  font-weight: 500;
}
.link-right {
  display: flex;
  align-items: center;
}
.link-name {
  font-size: 26rpx;
  color: #8B1A1A;
}
.link-arrow {
  font-size: 28rpx;
  color: #999;
  margin-left: 8rpx;
}

/* 商家 */
.seller-section {
  background: #ffffff;
  padding: 30rpx;
  margin-bottom: 2rpx;
  display: flex;
  align-items: center;
}
.seller-label {
  font-size: 28rpx;
  color: #2c1810;
  font-weight: 500;
  margin-right: 16rpx;
}
.seller-name {
  font-size: 26rpx;
  color: #666;
}

/* 底部栏 */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  align-items: center;
  background: #ffffff;
  padding: 12rpx 20rpx;
  padding-bottom: calc(12rpx + env(safe-area-inset-bottom));
  border-top: 2rpx solid #f0f0f0;
  z-index: 100;
}
.action-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-right: 12rpx;
  padding: 0 6rpx;
}
.action-icon {
  font-size: 30rpx;
}
.action-text {
  font-size: 18rpx;
  color: #666;
  margin-top: 2rpx;
}
.price-summary {
  margin-right: 12rpx;
  text-align: right;
}
.total-price-label {
  font-size: 20rpx;
  color: #999;
  display: block;
}
.total-price-num {
  font-size: 28rpx;
  color: #C41E3A;
  font-weight: 700;
}
.primary-btn {
  flex: 1;
  text-align: center;
  padding: 22rpx 0;
  border-radius: 40rpx;
  font-size: 28rpx;
  font-weight: 500;
}
.add-cart-btn {
  background: #fff0f0;
  color: #8B1A1A;
  border: 2rpx solid #8B1A1A;
  margin-right: 16rpx;
}
.buy-btn {
  background: linear-gradient(135deg, #8B1A1A, #C41E3A);
  color: #fff;
}

/* Toast */
.toast {
  position: fixed;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%) scale(0.8);
  background: rgba(0,0,0,0.75);
  color: #fff;
  padding: 20rpx 40rpx;
  border-radius: 12rpx;
  font-size: 28rpx;
  opacity: 0;
  transition: all 0.3s;
  z-index: 999;
  pointer-events: none;
}
.toast.toast-show {
  opacity: 1;
  transform: translate(-50%, -50%) scale(1);
}

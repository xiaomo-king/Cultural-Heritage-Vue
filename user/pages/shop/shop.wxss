.page {
  min-height: 100vh;
  background: #f5f0eb;
  padding-bottom: 140rpx;
}

/* 搜索栏 */
.search-row {
  display: flex;
  align-items: center;
  margin: 20rpx 30rpx;
  gap: 16rpx;
}
.search-bar {
  flex: 1;
  display: flex;
  align-items: center;
  padding: 20rpx 30rpx;
  background: #ffffff;
  border-radius: 40rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}
.cart-btn {
  width: 72rpx;
  height: 72rpx;
  background: #ffffff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
  flex-shrink: 0;
}
.cart-icon {
  font-size: 32rpx;
}
.search-icon {
  font-size: 28rpx;
  margin-right: 12rpx;
}
.search-placeholder {
  font-size: 26rpx;
  color: #999;
}

/* 轮播 */
.banner {
  height: 280rpx;
  margin: 0 30rpx 20rpx;
  border-radius: 16rpx;
  overflow: hidden;
}
.banner-item {
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  height: 100%;
  border-radius: 16rpx;
}
.banner-title {
  font-size: 40rpx;
  font-weight: 600;
  color: #fff;
  margin-bottom: 8rpx;
}
.banner-subtitle {
  font-size: 26rpx;
  color: rgba(255,255,255,0.85);
  margin-bottom: 16rpx;
}
.banner-tag {
  font-size: 22rpx;
  color: #fff;
  background: rgba(255,255,255,0.2);
  padding: 6rpx 24rpx;
  border-radius: 20rpx;
}

/* 分类网格 */
.category-grid {
  display: flex;
  flex-wrap: wrap;
  margin: 0 30rpx 24rpx;
  padding: 24rpx 10rpx;
  background: #ffffff;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}
.category-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 16.66%;
  margin-bottom: 8rpx;
}
.category-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 8rpx;
}
.category-emoji {
  font-size: 32rpx;
}
.category-name {
  font-size: 22rpx;
  color: #2c1810;
}

/* 商品列表头部 */
.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 0 30rpx 20rpx;
}
.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #2c1810;
}
.section-count {
  font-size: 24rpx;
  color: #999;
}

/* 商品列表 */
.product-list {
  display: flex;
  flex-wrap: wrap;
  padding: 0 30rpx;
  gap: 20rpx;
}
.product-card {
  width: calc(50% - 10rpx);
  background: #ffffff;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}
.product-image {
  width: 100%;
  height: 360rpx;
  background: #f0f0f0;
}
.product-info {
  padding: 20rpx;
}
.product-name {
  font-size: 26rpx;
  color: #2c1810;
  line-height: 1.4;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.product-meta {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  margin-top: 12rpx;
}
.price-row {
  display: flex;
  align-items: baseline;
}
.price-symbol {
  font-size: 22rpx;
  color: #C41E3A;
  font-weight: 600;
}
.price-num {
  font-size: 32rpx;
  color: #C41E3A;
  font-weight: 700;
}
.original-price {
  font-size: 22rpx;
  color: #bbb;
  text-decoration: line-through;
  margin-left: 8rpx;
}
.sales {
  font-size: 22rpx;
  color: #999;
}

/* 加载 */
.loading-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 0;
}
.loading-spinner {
  width: 48rpx;
  height: 48rpx;
  border: 4rpx solid #e0e0e0;
  border-top-color: #8B1A1A;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}
@keyframes spin {
  to { transform: rotate(360deg); }
}
.loading-text {
  font-size: 26rpx;
  color: #999;
  margin-top: 16rpx;
}

/* 空数据 */
.empty-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 0;
}
.empty-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}
.empty-text {
  font-size: 28rpx;
  color: #999;
}

/* 加载更多 */
.load-more {
  text-align: center;
  padding: 30rpx 0;
}
.load-more-text {
  font-size: 24rpx;
  color: #bbb;
}

/* pages/splash/splash.wxss */
.page {
  position: relative;
  width: 100vw;
  height: 100vh;
  overflow: hidden;
  background: #000;
}
.bg {
  width: 100%;
  height: 100%;
}
.skip-btn {
  position: absolute;
  top: 80rpx;
  right: 30rpx;
  padding: 12rpx 32rpx;
  background: rgba(255, 255, 255, 0.2);
  color: rgba(255, 255, 255, 0.85);
  border: 1rpx solid rgba(255, 255, 255, 0.3);
  border-radius: 30rpx;
  font-size: 26rpx;
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
  z-index: 10;
}
.skip-btn:active {
  background: rgba(255, 255, 255, 0.35);
}

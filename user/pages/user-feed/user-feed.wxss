/* pages/user-feed/user-feed.wxss */
.page { padding-bottom: 40rpx; background: #f5f0eb; min-height: 100vh; }

/* ===== 加载 ===== */
.loading-box { display: flex; justify-content: center; padding: 200rpx 0; }
.loading-spinner { width: 60rpx; height: 60rpx; border: 4rpx solid #f0e8e0; border-top-color: #8B1A1A; border-radius: 50%; animation: spin 0.8s linear infinite; }
@keyframes spin { to { transform: rotate(360deg); } }

/* ===== 用户信息 ===== */
.user-header {
  display: flex;
  flex-direction: column;
  align-items: center;
  background: #fff;
  padding: 40rpx 30rpx 30rpx;
  margin-bottom: 16rpx;
}
.avatar-section {
  position: relative;
  margin-bottom: 16rpx;
}
.user-avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: #f0e8e0;
}
.edit-avatar-btn {
  position: absolute;
  bottom: 0;
  right: -10rpx;
  background: #8B1A1A;
  color: #fff;
  font-size: 18rpx;
  padding: 4rpx 12rpx;
  border-radius: 16rpx;
}
.user-name {
  font-size: 34rpx;
  font-weight: 600;
  color: #2c1810;
  margin-bottom: 8rpx;
}
.user-info-row {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 4rpx;
}
.user-bio {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 10rpx;
  text-align: center;
}
.info-tags {
  display: flex;
  gap: 12rpx;
  margin-bottom: 4rpx;
}
.info-tag {
  font-size: 22rpx;
  color: #999;
  background: #f5f0eb;
  padding: 4rpx 16rpx;
  border-radius: 16rpx;
}

/* ===== 统计 ===== */
.user-stats {
  display: flex;
  gap: 60rpx;
  margin: 16rpx 0;
}
.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}
.stat-num {
  font-size: 30rpx;
  font-weight: 600;
  color: #2c1810;
}
.stat-label {
  font-size: 22rpx;
  color: #999;
  margin-top: 4rpx;
}

/* ===== 关注/编辑按钮 ===== */
.follow-btn {
  padding: 14rpx 48rpx;
  border-radius: 36rpx;
  font-size: 26rpx;
  background: #8B1A1A;
  color: #fff;
  margin-top: 12rpx;
}
.follow-btn.active {
  background: #f5f0eb;
  color: #999;
  border: 1px solid #ddd;
}
.edit-profile-btn {
  padding: 12rpx 40rpx;
  border-radius: 36rpx;
  font-size: 26rpx;
  background: #f5f0eb;
  color: #8B1A1A;
  border: 1px solid #e8ddd0;
  margin-top: 12rpx;
}

/* ===== 标题 ===== */
.section-title {
  display: flex;
  align-items: center;
  padding: 16rpx 30rpx;
  font-size: 28rpx;
  color: #2c1810;
  font-weight: 600;
}
.title-line {
  width: 6rpx;
  height: 28rpx;
  background: #8B1A1A;
  border-radius: 3rpx;
  margin-right: 12rpx;
}

/* ===== 打卡列表 ===== */
.post-list { padding: 0 30rpx; }
.post-card {
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
}
.post-cover {
  width: 100%;
  height: 360rpx;
  background: #f0e8e0;
}
.post-info { padding: 30rpx; }
.post-content-preview {
  font-size: 26rpx;
  color: #555;
  line-height: 1.6;
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.post-meta {
  display: flex;
  gap: 8rpx;
  align-items: center;
  padding: 16rpx 20rpx;
}
.heritage-tag {
  background: #f5f0eb;
  color: #8B1A1A;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
}
.visibility-tag {
  padding: 4rpx 12rpx;
  border-radius: 16rpx;
  font-size: 20rpx;
}
.visibility-tag.public { background: #e8f5e9; color: #2E7D32; }
.visibility-tag.private { background: #fff3e0; color: #E65100; }
.post-time { font-size: 20rpx; color: #ccc; margin-left: auto; }

/* ===== 空状态 ===== */
.empty-state { display: flex; flex-direction: column; align-items: center; padding: 120rpx 0; }
.empty-icon { font-size: 64rpx; margin-bottom: 16rpx; }
.empty-text { font-size: 28rpx; color: #999; }
